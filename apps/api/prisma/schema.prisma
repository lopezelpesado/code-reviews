// Prisma schema for the code-reviews technical test.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A simple greeting record used to prove the DB -> API -> UI path works.
model Greeting {
  id        Int      @id @default(autoincrement())
  message   String
  createdAt DateTime @default(now())
}

/// A named dashboard configuration that users can save and reopen.
/// Shared by everyone using the app; there are no per-user views.
model SavedView {
  id            Int      @id @default(autoincrement())
  /// Display name: trimmed, 1-60 characters (enforced by the API), unique across all views
  name          String   @unique
  /// World Bank indicator code, e.g. "NY.GDP.PCAP.CD". Deliberately not a relation to
  /// Indicator: a view outlives its indicator so that opening it can fail with a message.
  indicatorCode String
  /// Year shown on the dashboard; null means "use the indicator's latest year"
  year          Int?
  /// Comma-separated ISO 3166-1 alpha-3 codes for the line chart, e.g. "GBR,USA,FRA"
  countries     String
  /// Ranking order: "ASC" or "DESC" (validated by the API)
  order         String
  /// World Bank region name highlighted on the scatter, if any
  region        String?
  createdAt     DateTime @default(now())
}

/// A country as described by the World Bank API (aggregates such as "World" are excluded).
model Country {
  /// ISO 3166-1 alpha-3 code, e.g. "GBR"
  code            String  @id
  /// ISO 3166-1 alpha-2 code, e.g. "GB"
  iso2Code        String  @unique
  name            String
  /// World Bank region name, e.g. "Europe & Central Asia"
  region          String
  regionCode      String
  /// World Bank income classification, e.g. "High income"
  incomeLevel     String
  incomeLevelCode String
  capitalCity     String?
  latitude        Float?
  longitude       Float?

  observations Observation[]
}

/// A World Bank indicator (a measurable series such as GDP per capita).
model Indicator {
  /// World Bank indicator code, e.g. "NY.GDP.PCAP.CD"
  code               String    @id
  name               String
  sourceNote         String?
  sourceOrganization String?
  /// When observations for this indicator were last pulled from the API
  lastFetchedAt      DateTime?

  observations Observation[]
}

/// One value of one indicator for one country in one year.
model Observation {
  id            Int    @id @default(autoincrement())
  countryCode   String
  indicatorCode String
  year          Int
  value         Float

  country   Country   @relation(fields: [countryCode], references: [code], onDelete: Cascade)
  indicator Indicator @relation(fields: [indicatorCode], references: [code], onDelete: Cascade)

  @@unique([countryCode, indicatorCode, year])
  @@index([indicatorCode, year])
}
